# AgentSpace 2.0 Environment Variables Configuration

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentspace_dev?schema=public"

# Redis (BullMQ Worker Queue)
REDIS_URL="redis://localhost:6379"

# Security & Session Auth
AUTH_SECRET="your-super-secret-auth-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# AI Model Provider API Keys
GEMINI_API_KEY="your-gemini-api-key-here"

# Object Storage (S3 / R2 compatible storage)
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="your-storage-access-key"
STORAGE_SECRET_KEY="your-storage-secret-key"
STORAGE_BUCKET="agentspace-artifacts"

# App Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
